{
  "name": "jarvis-assistant",
  "productName": "Jarvis",
  "version": "1.0.0",
  "description": "Jarvis — голосовой ИИ-помощник для macOS и Windows",
  "main": "./out/main/index.js",
  "author": "Jarvis",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs --build",
    "assets": "node scripts/fetch-models.mjs && node scripts/gen-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --mac --arm64 --x64 && electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@ricky0123/vad-web": "^0.0.31",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.64.0",
    "onnxruntime-web": "^1.31.1",
    "playwright-core": "^1.64.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
